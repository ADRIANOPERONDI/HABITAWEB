# Ambiente
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'

# Banco de dados
database.default.hostname = 127.0.0.1
database.default.database = habitaweb
database.default.username = habitaweb
database.default.password = CHANGE_ME
database.default.DBDriver = Postgre
database.default.port = 5432
database.default.charset = utf8
database.default.DBDebug = true

# Gere uma chave exclusiva com: php spark key:generate
encryption.key =

# Segredo de assinatura dos JWT da API v1 (HS256).
# Opcional: se ficar vazio, é derivado de encryption.key via HMAC — a API
# funciona sem configuração extra. Defina explicitamente quando quiser rotacionar
# os tokens da API sem mexer na chave de criptografia da aplicação.
# Gere com: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET =

# Cache e sessão
cache.handler = file
cache.backupHandler = file
cache.redis.host = 127.0.0.1
cache.redis.port = 6379
cache.redis.timeout = 1
cache.redis.database = 0
session.driver = CodeIgniter\Session\Handlers\FileHandler
session.savePath =

# E-mail
email.protocol = smtp
email.fromEmail = no-reply@example.com
email.fromName = Habitaweb

# Pagamentos: configure somente no ambiente de execução
ASAAS_ENV = sandbox
ASAAS_API_KEY =
ASAAS_WEBHOOK_TOKEN =
ASAAS_WEBHOOK_SECRET =
ASAAS_SUBSCRIPTION_BILLING_TYPE = UNDEFINED
ASAAS_SINGLE_CHARGE_BILLING_TYPES = PIX,BOLETO,CREDIT_CARD

# Cobrança por lead recebido
# Data (YYYY-MM-DD) a partir da qual LeadChargeRuleSeeder grava valid_from nas
# regras padrão de plataforma. Vazio = hoje (LeadChargeRuleSeeder::run()).
# Em produção, use a data real da virada comercial (ver runbook §13.1) — não
# a data do deploy, se ele sair antes da virada combinada.
LEAD_CHARGE_VALID_FROM =

# Storage
storage.driver = local
storage.s3.key =
storage.s3.secret =
storage.s3.region =
storage.s3.bucketPublic =
storage.s3.bucketPrivate =
storage.s3.endpoint =
storage.s3.publicBaseUrl =

# Mapa (tiles do Leaflet)
# OBRIGATÓRIO em produção. Sem isto o portal cai no servidor de tiles do
# OpenStreetMap, que é mantido por doação, não permite uso comercial e já
# bloqueou o domínio uma vez — o mapa inteiro vira quadros "Access blocked".
#
# ATENÇÃO: valor com espaço TEM de vir entre aspas. O DotEnv do CodeIgniter
# lança InvalidArgumentException no boot se não vier, e o site inteiro sai do ar
# com erro 500 — não é um aviso, é fatal. A atribuição sempre tem espaço.
#
# Auto-hospedado (a única opção sem chave, sem mensalidade e que ninguém pode
# bloquear — runbook completo em GUIA_ESCALABILIDADE_PRODUCAO.md §14):
#   MAP_TILE_URL = https://SEU_DOMINIO/tiles/styles/basic-preview/{z}/{x}/{y}.png
#   MAP_TILE_ATTRIBUTION = '&copy; <a href="https://www.openmaptiles.org/">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>'
#   Ordem {z}/{x}/{y} normal. A atribuição credita DOIS projetos e é exigência
#   de licença, não cortesia: o dado é OSM sob ODbL e o esquema de tiles é
#   OpenMapTiles sob CC-BY.
#
# Com chave de terceiro:
#   MapTiler: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=SUA_CHAVE
#   Mapbox:   https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles/{z}/{x}/{y}?access_token=SEU_TOKEN
#
# Esri sem chave — funciona, mas os termos ATUAIS da Esri exigem token
# ("you are required to pass access token authentication with all ArcGIS
# location services used by your application, including basemaps"). Serve como
# tapa-buraco, não como destino: é a mesma situação da OSM antes do bloqueio.
#   MAP_TILE_URL = https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
#   MAP_TILE_ATTRIBUTION = 'Tiles &copy; Esri &mdash; Esri, HERE, Garmin, USGS, NGA'
#   Repare no {z}/{y}/{x}: o Esri inverte y e x. Com {z}/{x}/{y} o mapa carrega
#   normalmente, sem erro nenhum, mostrando o LUGAR ERRADO (a checagem de São
#   Miguel do Oeste caiu na Romênia).
#
# Já testados e que NÃO servem: tile.openstreetmap.org devolve HTTP 200 com a
# imagem "Access blocked" (o status não denuncia nada — olhe o pixel);
# basemaps.cartocdn.com devolve o tile carimbado "API KEY REQUIRED";
# tile.openstreetmap.de funciona mas é o mesmo modelo voluntário que já bloqueou.
#
# A atribuição é exigida por contrato/licença — troque junto com a URL.
#
# MAP_TILE_SIZE: lado do tile que o provedor entrega. O Leaflet assume 256 e
# encaixa a imagem nesse espaco — com um provedor de 512 (o caso do ArcGIS
# Static Basemap Tiles) o mapa mostra o DOBRO da area no mesmo zoom. Nao
# quebra: fica silenciosamente na escala errada, e so se percebe comparando
# lado a lado. Provedor de 512 precisa TAMBEM de MAP_TILE_ZOOM_OFFSET = -1.
# Em duvida, baixe um tile e veja: `curl -s <url> -o t.png && file t.png`.
#
# Esri Static Basemap Tiles (com chave), verificado: 512 e -1
#   MAP_TILE_URL = https://static-map-tiles-api.arcgis.com/arcgis/rest/services/static-basemap-tiles-service/v1/arcgis/streets/static/tile/{z}/{y}/{x}?token=SUA_CHAVE
#   MAP_TILE_ATTRIBUTION = 'Tiles &copy; Esri &mdash; Esri, HERE, Garmin, USGS, NGA'
#   MAP_TILE_SIZE = 512
#   MAP_TILE_ZOOM_OFFSET = -1
MAP_TILE_URL =
MAP_TILE_ATTRIBUTION =
MAP_TILE_MAX_ZOOM = 19
MAP_TILE_SIZE = 256
MAP_TILE_ZOOM_OFFSET = 0
