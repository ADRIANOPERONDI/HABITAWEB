<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
    bootstrap="vendor/codeigniter4/framework/system/Test/bootstrap.php"
    backupGlobals="false"
    beStrictAboutOutputDuringTests="true"
    colors="true"
    columns="max"
    failOnRisky="true"
    failOnWarning="true"
    cacheDirectory="build/.phpunit.cache">
    <coverage
        includeUncoveredFiles="true"
        pathCoverage="false"
        ignoreDeprecatedCodeUnits="true"
        disableCodeCoverageIgnore="true">
        <report>
            <clover outputFile="build/logs/clover.xml"/>
            <html outputDirectory="build/logs/html"/>
            <php outputFile="build/logs/coverage.serialized"/>
            <text outputFile="php://stdout" showUncoveredFiles="false"/>
        </report>
    </coverage>
    <testsuites>
        <!-- Smoke tests que não sobem HTTP simulado (storage, health, config de
             gateway). A antiga tests/unit/APITest foi removida; a cobertura real
             da API vive em tests/Feature/Api. -->
        <testsuite name="unit">
            <directory>./tests/unit</directory>
        </testsuite>
        <!-- Suítes que sobem o framework via Tests\Support\HabitawebTestCase
             (FeatureTestTrait + DatabaseTestTrait + transação com rollback real).
             tests/Feature/Api concentra a superfície da API v1. -->
        <testsuite name="feature">
            <directory>./tests/Feature</directory>
        </testsuite>
        <testsuite name="e2e">
            <directory>./tests/E2E</directory>
        </testsuite>
    </testsuites>
    <logging>
        <testdoxHtml outputFile="build/logs/testdox.html"/>
        <testdoxText outputFile="build/logs/testdox.txt"/>
        <junit outputFile="build/logs/logfile.xml"/>
    </logging>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
        <exclude>
            <directory suffix=".php">./app/Views</directory>
            <file>./app/Config/Routes.php</file>
        </exclude>
    </source>
    <php>
        <server name="app.baseURL" value="http://example.com/"/>
        <server name="CODEIGNITER_SCREAM_DEPRECATIONS" value="0"/>
        <env name="database.tests.hostname" value="localhost"/>
        <env name="database.tests.database" value="habitaweb_test"/>
        <env name="database.tests.username" value="postgres"/>
        <env name="database.tests.password" value="postgres"/>
        <env name="database.tests.DBDriver" value="Postgre"/>
        <env name="database.tests.port" value="5432"/>
        <env name="database.tests.DBPrefix" value=""/>
        <!-- Recomendado pela doc do Shield para acelerar testes que criam usuários
             (bcrypt cost 12 -> 4 só no ambiente de teste; NUNCA em produção). -->
        <env name="auth.hashCost" value="4"/>
        <!-- Token FIXO só para testes de assinatura de webhook (não é segredo de
             produção — .env.testing não é lido pelo PHPUnit, ver run_tests.sh). -->
        <env name="ASAAS_WEBHOOK_TOKEN" value="phpunit-fixed-webhook-token"/>
        <!-- Chave FIXA só para teste (não é segredo de produção), necessária para
             Services::encrypter() (credenciais de gateway/integração cifradas).
             Sem isto, um checkout novo sem .env local (CI, por exemplo) falha em
             qualquer teste que toque PaymentGatewayConfigModel/IntegrationService
             com "Encrypter needs a starter key" — .env.testing não é lido pelo
             PHPUnit, mesmo motivo do ASAAS_WEBHOOK_TOKEN acima. -->
        <env name="encryption.key" value="hex2bin:40f71c4fe7f7381b05fa0f6ce1c7ebc2fb89c367f18932b5b8976de51785b78f"/>
        <!-- Mesmo motivo das duas acima: PaymentGatewayConfigModel::recoverSensitiveValue()
             lê ASAAS_ENV do ambiente pra reparar a config 'environment' quando a
             descriptografia falha — sem .env local (CI), essa recuperação nunca
             tem valor pra recuperar. -->
        <env name="ASAAS_ENV" value="sandbox"/>
        <!-- Directory containing phpunit.xml -->
        <const name="HOMEPATH" value="./"/>
        <!-- Directory containing the Paths config file -->
        <const name="CONFIGPATH" value="./app/Config/"/>
        <!-- Directory containing the front controller (index.php) -->
        <const name="PUBLICPATH" value="./public/"/>
        <!-- Database configuration -->
        <!-- Uncomment to provide your own database for testing
            <env name="database.tests.hostname" value="localhost"/>
            <env name="database.tests.database" value="tests"/>
            <env name="database.tests.username" value="tests_user"/>
            <env name="database.tests.password" value=""/>
            <env name="database.tests.DBDriver" value="MySQLi"/>
            <env name="database.tests.DBPrefix" value="tests_"/>
            -->
    </php>
</phpunit>
